# PostelOS - environment variables (names only; never commit real values).
# Put real values in .env.local (local) and in Netlify -> Site settings -> Environment variables (production).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only. Without it every API route returns 503.

# --- Access control ---
OWNER_EMAIL=hello@postelstudio.com  # MUST equal the email of the Supabase account you sign in with; the ONLY account allowed in; also the target of "Send test email to myself"
NEXT_PUBLIC_ALLOW_SIGNUP=false      # leave false; true re-enables the public Register button
CRON_SECRET=                        # bearer secret for /api/autopilot/* (required in production)

# --- AI (CEO agent + ARIA) ---
GEMINI_API_KEY=
GEMINI_MODEL=                       # optional (default set in code)
GEMINI_FALLBACK_MODELS=             # optional, comma separated
GEMINI_DEADLINE_MS=                 # optional per-call deadline
ORCHESTRATOR_BUDGET_MS=             # optional time budget per /api/ceo run (serverless limit)

# --- Email: choose ONE provider (EMAIL_PROVIDER = resend | gmail | gmail-oauth | gmail-smtp; auto-detected if empty) ---
EMAIL_PROVIDER=
# Resend (needs a VERIFIED sending domain; the sandbox sender only reaches your own account email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="PostelOS <hello@postelstudio.com>"   # postelstudio.com must be verified in Resend (SPF + DKIM DNS records)
# Gmail SMTP (easiest): Google account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
# Gmail OAuth2 (alternative to app password; also needs GMAIL_USER above)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Common
EMAIL_REPLY_TO=hello@postelstudio.com
EMAIL_FOOTER_ADDRESS=               # postal address line shown in the footer / unsubscribe block
NOTIFY_EMAIL=                       # legacy fallback for OWNER_EMAIL

# --- Send guardrails ---
OUTREACH_SEND_ENABLED=false         # kill switch: must be exactly "true" for ANY real send to leads
OUTREACH_DAILY_CAP=15
OUTREACH_BLACKLIST=                 # comma separated emails / domains never to contact
OUTREACH_TIMEZONE=America/Los_Angeles

# --- Voice (optional; browser speechSynthesis is the no-key fallback) ---
TTS_PROVIDER=                       # auto (default) | elevenlabs | voicebox | browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
VOICEBOX_URL=                       # only if you actually run a Voicebox server
VOICEBOX_PROFILE_ID=

# --- Optional ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=hello@postelstudio.com
